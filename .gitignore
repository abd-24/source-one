# ── Data (regenerable from raw + code, never commit — often huge) ──
data/raw/*
data/processed/*
data/candidates/*
data/features/*
data/embeddings_cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/candidates/.gitkeep
!data/features/.gitkeep
!data/embeddings_cache/.gitkeep
# keep the split ID files though — small, and needed for reproducibility
!data/splits/*.json

# ── Model artifacts (large binary, regenerable by re-running train.py) ──
*.pkl
*.pickle
*.joblib
*.txt.model          # LightGBM native model format
*.lgb
models/*.bin
**/checkpoints/

# ── Embeddings cache (large binary vectors) ──
*.npy
*.npz
*.faiss
*.index

# ── Output files that change every run (keep folder, not contents) ──
output/*.tsv
output/*.json
output/*.csv
!output/.gitkeep

# ── Experiment scratch space (not meant to be tracked at all) ──
experiments/blocking/*
experiments/features/*
experiments/models/*
experiments/submissions/*.tsv
!experiments/blocking/.gitkeep
!experiments/features/.gitkeep
!experiments/models/.gitkeep
# keep the submission log though — it's your tracking history, small text
!experiments/submissions/submission_log.csv

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──
venv/
.venv/
env/
ENV/

# ── Jupyter ──
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ── OS / editor junk ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── Logs ──
*.log
logs/

# ── Environment / secrets (if any config ever needs a key) ──
.env
*.env.local

# ── The final zip itself — build artifact, not source ──
*_submission.zip